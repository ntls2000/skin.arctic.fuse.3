<?xml version='1.0' encoding='utf-8'?>
<addons>
    <addon id="repository.ntls2000.kodi.dev" name="NTLS2000 - Kodi DEV Repository" version="0.1.0" provider-name="ntls2000">
        <extension point="xbmc.addon.repository" name="NTLS2000 Kodi DEV">
            <dir>
                <info compressed="false">https://raw.githubusercontent.com/ntls2000/skin.arctic.fuse.3/kodi-repo/kodi-repository/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/ntls2000/skin.arctic.fuse.3/kodi-repo/kodi-repository/addons.xml.md5</checksum>
                <datadir>https://raw.githubusercontent.com/ntls2000/skin.arctic.fuse.3/kodi-repo/kodi-repository/</datadir>
                <hashes>false</hashes>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Development repository for Kodi test builds</summary>
            <description lang="en_GB">Test channel for isolated Arctic Fuse 3 adaptations. Third-party dependencies remain managed by their original Kodi repositories.</description>
            <summary lang="fr_FR">Depot de test pour les versions Kodi modifiees</summary>
            <description lang="fr_FR">Canal de test pour une version independante d'Arctic Fuse 3. Les extensions externes restent gerees par leurs depots habituels.</description>
            <platform>all</platform>
        </extension>
    </addon>
    <addon id="skin.arctic.fuse.3.dev" name="Arctic Fuse 3 DEV (Original)" provider-name="jurialmunkey / ntls2000" version="3.4.2.45">
        <requires>
            <import addon="xbmc.gui" version="5.17.0" />
            <import addon="script.skinvariables" version="2.2.9" />
            <import addon="script.texturemaker" version="0.2.9" />
            <import addon="plugin.video.themoviedb.helper" version="6.17.9" />
            <import addon="resource.images.weathericons.white" version="0.0.1" />
            <import addon="resource.images.arctic.splash" version="1.0.0" />
            <import addon="resource.images.studios.coloured" version="0.0.1" />
            <import addon="resource.font.robotocjksc" version="0.0.3" />
            <import addon="service.skin.arctic.fuse.3.dev.trailers" version="0.4.8" />
        </requires>
        <extension debugging="false" defaultthemename="Textures.xbt" effectslowdown="1" point="xbmc.gui.skin">
            <res aspect="16:9" default="true" folder="1080i" width="1920" height="1080" />
            <res aspect="3:2" default="false" folder="1080i" width="1620" height="1080" />
            <res aspect="4:3" default="false" folder="1080i" width="1440" height="1080" />
            <res aspect="16:10" default="false" folder="1080i" width="1728" height="1080" />
            <res aspect="17:9" default="false" folder="1080i" width="2040" height="1080" />
            <res aspect="21:9" default="false" folder="1080i" width="2520" height="1080" />
            <res aspect="19.5:9" default="false" folder="1080i" width="2340" height="1080" />
            <res aspect="18:9" default="false" folder="1080i" width="2160" height="1080" />
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">A minimal row based skin</summary>
            <summary lang="es">Una skin minimalista de diseño horizontal</summary>
            <summary lang="de">Ein minimalistisches, zeilenbasiertes Skin</summary>
            <summary lang="zh">简约行式布局皮肤</summary>
            <summary lang="ar">سكن مخفف بقوائم افقية</summary>
            <description lang="en">Arctic Fuse 3 is a minimal row based skin with customisable widgets</description>
            <description lang="es">Arctic Fuse 3 es una skin minimalista de diseño horizontal con widgets personalizables</description>
            <description lang="de">Arctic Fuse 3 ist ein minimalistisches, zeilenbasiertes Skin mit anpassbaren Widgets</description>
            <description lang="zh">Arctic Fuse 3 是一款采用简约行式布局的 Kodi 皮肤，支持小组件自定义功能</description>
            <description lang="ar">Arctic Fuse 3 سكن مخفف بقوائم افقية وبامكانية تخصيص الاختصارات</description>
            <platform>all</platform>
            <license>Creative Commons Attribution Non-Commercial Share-Alike 4.0</license>
            <forum />
            <source />
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="service.skin.arctic.fuse.3.dev.trailers" name="AF3 DEV - Spotlight Trailers" version="0.4.8" provider-name="ntls2000">
        <requires>
            <import addon="xbmc.python" version="3.0.1" />
        </requires>
        <extension point="xbmc.service" library="service.py" start="startup" />
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Spotlight trailer preview for Arctic Fuse 3 DEV</summary>
            <description lang="en_GB">Spotlight Films keeps its proven local Emby trailer path. TV Series resolve Emby Next Gen indexed ThemeVideo, using local downloaded themes or authenticated Emby streams. No YouTube dependency, read-only metadata, native nonblocking Stop; disabled by default.</description>
            <summary lang="fr_FR">Bandes-annonces du Spotlight pour Arctic Fuse 3 DEV</summary>
            <description lang="fr_FR">Films inchanges; Series : ThemeVideo Emby locale ou sur serveur, via index Kodi/Emby en lecture seule. Sans YouTube. Stop natif et widgets preserves.</description>
            <platform>all</platform>
            <license>MIT</license>
        </extension>
    </addon>
