<?xml version='1.0' encoding='utf-8'?>
<smartplaylist type="movies">
    <name>Films : horreur</name>
    <match>all</match>
    <rule field="genre" operator="contains">
        <value>Horreur</value>
        <value>Horror</value>
    </rule>
    <limit>60</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>