<?xml version='1.0' encoding='utf-8'?>
<smartplaylist type="tvshows">
    <name>Séries : drames</name>
    <match>all</match>
    <rule field="genre" operator="contains">
        <value>Drame</value>
        <value>Drama</value>
    </rule>
    <limit>60</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>