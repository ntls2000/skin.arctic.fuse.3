<?xml version='1.0' encoding='utf-8'?>
<smartplaylist type="movies">
    <name>Films : action &amp; aventure</name>
    <match>all</match>
    <rule field="genre" operator="contains">
        <value>Action</value>
        <value>Aventure</value>
        <value>Adventure</value>
    </rule>
    <limit>60</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>