<?xml version='1.0' encoding='utf-8'?>
<smartplaylist type="movies">
    <name>Films : romance &amp; émotions</name>
    <match>all</match>
    <rule field="genre" operator="contains">
        <value>Romance</value>
        <value>Romantique</value>
        <value>Romantic</value>
    </rule>
    <limit>60</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>